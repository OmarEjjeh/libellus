% --- Gregoriotex ---
\usepackage[autocompile]{gregoriotex}
\gresetlinecolor{black}
\grechangedim{spaceabovelines}{0.35cm}{scalable}
\grechangedim{spacebeneathtext}{0.15cm}{scalable}
\gresetgregoriofont[op]{greciliae}
% The only score with a second text line is the Kurzfassung's Magnificat
% system, where that line is verse 2 — sung Latin, not a translation, so it is
% set upright rather than in gregorio's italic translation style (ADR-0022).
\grechangestyle{translation}{}

% Gregorio typesets a translation in an \hbox to 0pt (gregoriotex-main.tex,
% \GreWriteTranslation), so it claims no width at all: the spacing engine
% budgets a syllable from \wd\gre@box@syllabletext, the LYRIC's width, and a
% second line wider than the lyric above it simply prints into its neighbour —
% „sul-" over „tá-", „De-" over „o". Nothing on the lyric side can fix that,
% because verbatim padding is emitted but never measured, and widening
% intersyllablespacenotes moves the notes without moving the text.
%
% So the syllable is padded here by however much the line beneath overhangs it.
% Only scores that carry a translation are affected, which in this booklet means
% the Magnificat system alone.
\makeatletter
\newsavebox{\gretransbox}
\let\gre@orig@writetranslation\GreWriteTranslation
\def\GreWriteTranslation#1{%
  \gre@orig@writetranslation{#1}%
  \sbox\gretransbox{\gre@style@translation#1\endgre@style@translation}%
  \ifdim\wd\gretransbox>\wd\gre@box@syllabletext
    \kern\dimexpr\wd\gretransbox-\wd\gre@box@syllabletext\relax
  \fi}
\makeatother

